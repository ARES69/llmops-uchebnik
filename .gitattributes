# Нормализуем переводы строк, чтобы проект одинаково работал на Windows и Linux.
#
# Почему это важно именно здесь:
#   * server-setup.sh едет на VPS и исполняется bash — CRLF в нём даёт
#     «/bin/bash^M: bad interpreter» и скрипт не стартует вообще;
#   * PowerShell на Windows понимает оба варианта, но CRLF для него привычнее.

# --- текст, который должен остаться LF ---
*.sh    text eol=lf
*.py    text eol=lf
*.js    text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.conf  text eol=lf
*.json  text eol=lf

# --- Windows ---
*.ps1   text eol=crlf
*.psm1  text eol=crlf
*.bat   text eol=crlf
*.cmd   text eol=crlf

# --- двоичное, не трогаем ---
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.pdf   binary